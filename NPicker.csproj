<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios</TargetFrameworks>
		<!-- Uncomment to also build the tizen app. You will need to install tizen by following this: https://github.com/Samsung/Tizen.NET -->
		<!-- <TargetFrameworks>$(TargetFrameworks);net9.0-tizen</TargetFrameworks> -->
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">17.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>
		<Title>NPicker</Title>
		<Authors>ederbond</Authors>
		<Company>Cardoso Team Software</Company>
		<Description>A collection of Picker controls for .NET MAUI that supports nullable values</Description>
		<PackageProjectUrl>https://github.com/ederbond/NPicker</PackageProjectUrl>
		<Copyright>Eder Cardoso</Copyright>
		<RepositoryUrl>https://github.com/ederbond/NPicker</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Picker;DatePicker;TimePicker;MAUI;Android;iOS;Windows;MacOS</PackageTags>
		<PackageIcon>icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<Configurations>Release;Debug;DebugReview;DebugPreProd;ReleasePreProd;ReleaseReview</Configurations>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="Platforms\Tizen\**" />
	  <EmbeddedResource Remove="Platforms\Tizen\**" />
	  <MauiCss Remove="Platforms\Tizen\**" />
	  <MauiXaml Remove="Platforms\Tizen\**" />
	  <None Remove="Platforms\Tizen\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
		<PackageReference Include="SkiaSharp" Version="4.153.1" />
		<PackageReference Include="SkiaSharp.Views.Maui.Controls" Version="4.153.1" />
	</ItemGroup>

	<ItemGroup>
		<None Include="icon.png" Pack="true" Visible="false" PackagePath="" />
	</ItemGroup>


	<!-- Android default -->
	<PropertyGroup>
		<AndroidNdkVersion>29.0.14033849.4</AndroidNdkVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$(TargetFramework.Contains('-android'))">
		<AndroidAapt2NoCompress>ttf;otf</AndroidAapt2NoCompress>
		<!-- Forces compilation and deployment to target Android 16 (API 36) -->
		<TargetPlatformVersion>36.0</TargetPlatformVersion>
	</PropertyGroup>
</Project>
